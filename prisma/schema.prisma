generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

// 밴드 멤버 (메인 + 객원)
model Member {
  id          String  @id @default(cuid())
  name        String  @unique
  isGuest     Boolean @default(false) // 객원 여부
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  roles       String? // 담당 역할 (쉼표 구분: "보컬,일렉기타")
  photo       String? // 프로필 사진 파일명 (uploads/ 폴더)

  attendances Attendance[]
  votes       PollVote[]
}

// 합주 기록 (정산 단위)
model Rehearsal {
  id             String   @id @default(cuid())
  date           DateTime // 합주 날짜/시간
  hours          Int      @default(2) // 합주 시간 (보통 2, 가끔 3)
  roomCost       Int      @default(0) // 합주실 비용 (원)
  afterPartyCost Int      @default(0) // 뒤풀이 비용 (원, 0이면 뒤풀이 없음)
  memo           String?
  createdAt      DateTime @default(now())

  attendances Attendance[]
  songs       RehearsalSong[]
  journal     JournalEntry[]
}

// 합주 일지 (사진 + 한줄 기록 아카이브)
model JournalEntry {
  id          String   @id @default(cuid())
  rehearsalId String?
  text        String?
  photo       String? // uploads/ 폴더 파일명
  author      String? // 남긴 사람 이름
  createdAt   DateTime @default(now())

  rehearsal Rehearsal? @relation(fields: [rehearsalId], references: [id], onDelete: SetNull)
}

// 합주곡
model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  link      String? // 유튜브/악보 링크
  artwork   String? // 앨범 커버 이미지 URL (iTunes)
  createdAt DateTime @default(now())

  rehearsals RehearsalSong[]
  sheets     SheetMusic[]
}

// 곡별 악보 파일 (파트별 업로드)
model SheetMusic {
  id        String   @id @default(cuid())
  songId    String
  part      String // 보컬/드럼/베이스/일렉기타/어쿠스틱기타/키보드/기타
  file      String // uploads/ 폴더 파일명
  filename  String // 업로드한 원본 파일명
  uploader  String? // 올린 사람 이름
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

// 합주별 연습곡
model RehearsalSong {
  id          String @id @default(cuid())
  rehearsalId String
  songId      String

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  song      Song      @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, songId])
}

// 합주별 멤버 참석 정보
model Attendance {
  id          String  @id @default(cuid())
  rehearsalId String
  memberId    String
  late        Boolean @default(false) // 지각 여부 → 1시간 비용의 절반 추가 부담
  afterParty  Boolean @default(false) // 뒤풀이 참석 여부

  rehearsal Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, memberId])
}

// 합주 스케줄 투표
model SchedulePoll {
  id        String   @id @default(cuid())
  title     String // 예: "8월 첫째주 합주"
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  options PollOption[]
}

// 투표 후보 날짜/시간
model PollOption {
  id       String   @id @default(cuid())
  pollId   String
  startsAt DateTime // 후보 시작 시각

  poll  SchedulePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

// 멤버별 가능 여부
model PollVote {
  id        String  @id @default(cuid())
  optionId  String
  memberId  String
  available Boolean @default(true)

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([optionId, memberId])
}
